<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="650.0" style="-fx-background-color: linear-gradient(to bottom right, #1a1c29, #2b2e4a);" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.GUI.controllers.ResetPassword.NewPasswordController">
   <!-- ==================== TOP HEADER ==================== -->
   <top>
      <VBox spacing="5" style="-fx-padding: 15 25 10 25; -fx-background-color: rgba(0,0,0,0.2);">
         <HBox alignment="CENTER_LEFT" spacing="15">
            <Button fx:id="goBackButton" mnemonicParsing="false" onAction="#goBack" prefHeight="32.0" style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-text-fill: #c5c9d6; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1; -fx-cursor: hand; -fx-padding: 0 15;" text="← Go Back">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Region HBox.hgrow="ALWAYS" />
            <Label style="-fx-font-size: 28px;" text="🔑" />
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Password Change" textFill="#e0e4f0" />
            <Region HBox.hgrow="ALWAYS" />
         </HBox>
         <Separator style="-fx-background-color: rgba(255,255,255,0.1);" />
      </VBox>
   </top>
   <!-- ==================== CENTER CONTENT ==================== -->
   <center>
      <VBox alignment="CENTER" spacing="25.0" style="-fx-background-color: rgba(255, 255, 255, 0.07); -fx-border-color: rgba(255, 255, 255, 0.12); -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 20, 0, 0, 10);" BorderPane.alignment="CENTER">
         <VBox.margin>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
         </VBox.margin>
         <padding>
            <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
         </padding>
         <!-- Form Title -->
         <VBox alignment="CENTER" spacing="5">
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Reset Your Password" textFill="WHITE" />
            <Label style="-fx-font-size: 14px;" text="Create a new secure password for your account" textFill="#a0a5b5" />
         </VBox>
         <Separator prefWidth="400" style="-fx-background-color: rgba(255,255,255,0.1);" />
         <!-- New Password Field -->
         <VBox prefWidth="420" spacing="8.0">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="✨ New Password" textFill="#c5c9d6" />
            <PasswordField fx:id="newPasswordField" prefHeight="35.0" prefWidth="548.0" promptText="Enter your new password" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-inner-color: white; -fx-prompt-text-fill: #80869a; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-padding: 0 15;">
               <font>
                  <Font size="16.0" />
               </font>
            </PasswordField>
         </VBox>
         <!-- Confirm New Password Field -->
         <VBox prefWidth="420" spacing="8.0">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="✅ Confirm New Password" textFill="#c5c9d6" />
            <PasswordField fx:id="confirmNewPasswordField" prefHeight="44.0" promptText="Confirm your new password" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-inner-color: white; -fx-prompt-text-fill: #80869a; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-padding: 0 15;">
               <font>
                  <Font size="16.0" />
               </font>
            </PasswordField>
         </VBox>
         <!-- Password Requirements -->
         <VBox prefWidth="420" spacing="5" style="-fx-padding: 5 0 0 0;">
            <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="📋 Password Requirements:" textFill="#a0a5b5" />
            <HBox spacing="20" style="-fx-padding: 5 0 0 0;">
               <VBox spacing="3">
                  <Label style="-fx-font-size: 12px;" text="✓ At least 8 characters" textFill="#6c728f" />
                  <Label style="-fx-font-size: 12px;" text="✓ Uppercase &amp; lowercase letters" textFill="#6c728f" />
               </VBox>
               <VBox spacing="3">
                  <Label style="-fx-font-size: 12px;" text="✓ Includes at least one number" textFill="#6c728f" />
                  <Label style="-fx-font-size: 12px;" text="✓ Includes special character" textFill="#6c728f" />
               </VBox>
            </HBox>
         </VBox>
         <Separator prefWidth="400" style="-fx-background-color: rgba(255,255,255,0.1);" />
         <!-- Action Buttons -->
         <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;">
            <Button fx:id="changePasswordButton" mnemonicParsing="false" onAction="#changePassword" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: linear-gradient(to right, #2563eb, #3b82f6); -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-effect: dropshadow(three-pass-box, rgba(37, 99, 235, 0.3), 15, 0, 0, 5);" text="Change Password">
               <font>
                  <Font size="16.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#goBack" prefHeight="45.0" prefWidth="120.0" style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-text-fill: #c5c9d6; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1; -fx-cursor: hand; -fx-font-size: 16px;" text="Cancel">
               <font>
                  <Font size="16.0" />
               </font>
            </Button>
         </HBox>
         <!-- Status/Error Message -->
         <Label fx:id="statusLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="" textFill="#ef4444" />
      </VBox>
   </center>
   <!-- ==================== BOTTOM FOOTER ==================== -->
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="20" style="-fx-padding: 12 25 12 25; -fx-background-color: rgba(0,0,0,0.2);">
         <Label style="-fx-font-size: 12px;" text="🔐 Password Reset" textFill="#6c728f" />
         <Region HBox.hgrow="ALWAYS" />
         <Label style="-fx-font-size: 12px;" text="Secure password reset process" textFill="#6c728f" />
      </HBox>
   </bottom>
</BorderPane>
