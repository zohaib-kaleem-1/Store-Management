<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>
<AnchorPane
stylesheets="@/com/store/styles/view-style.css" 
 prefHeight="727.0" prefWidth="848.0" style="-fx-background-color: #2b2e4a;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.GUI.controllers.AdminControllers.ManageItem.ManageItemController">
    <children>
        <!-- Title -->
        <Label layoutX="-1.0" layoutY="14.0" prefHeight="57.0" prefWidth="848.0" style="-fx-alignment: center; -fx-font-weight: bold; -fx-text-fill: #e0e4f0;" text="📦 Manage Items" textAlignment="CENTER">
            <font>
                <Font size="40.0" />
            </font>
        </Label>
        <!-- Go Back Button -->
        <Button layoutX="38.0" layoutY="30.0" onAction="#goBack" prefHeight="30.0" prefWidth="93.0" style="-fx-background-color: #3d405b; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #4a4d6a; -fx-border-width: 1.5; -fx-text-fill: #c5c9d6; -fx-font-weight: bold;" text="← Back" />
        <!-- Search and Action Bar -->
        <HBox alignment="CENTER_LEFT" layoutX="34.0" layoutY="93.0" prefHeight="50.0" prefWidth="775.0" spacing="10" style="-fx-background-color: #1a1c29; -fx-background-radius: 8; -fx-padding: 8 12;">
            <!-- Search Field -->
            <TextField fx:id="searchItemNameField" prefHeight="34.0" prefWidth="220.0" promptText="🔍 Search by item name..." style="-fx-background-color: #3d405b; -fx-text-fill: white; -fx-prompt-text-fill: #80869a; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #4a4d6a; -fx-border-width: 1.5; -fx-padding: 0 12;">
                <font>
                    <Font size="14.0" />
                </font>
            </TextField>
            <!-- Push remaining items to the right -->
            <Region prefHeight="34.0" prefWidth="47.0" HBox.hgrow="ALWAYS" />
            <!-- Refresh Button -->
            <Button onAction="#refreshItems" prefHeight="34.0" style="-fx-background-color: #3d405b; -fx-text-fill: #3498db; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #4a4d6a; -fx-border-width: 1.5; -fx-font-weight: bold; -fx-padding: 0 15;" text="🔄 Refresh" />
            <!-- Add Button -->
            <Button onAction="#goToAddItem" prefHeight="34.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-padding: 0 15;" text="➕ Add" />
            <!-- Update Button -->
            <Button onAction="#goToUpdateItem" prefHeight="34.0" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-padding: 0 15;" text="✏️ Update" />
            <!-- Delete Button -->
            <Button onAction="#deleteItem" prefHeight="34.0" style="-fx-background-color: #3d405b; -fx-text-fill: #ef4444; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #4a4d6a; -fx-border-width: 1.5; -fx-font-weight: bold; -fx-padding: 0 15;" text="🗑️ Delete" />
        </HBox>
        <!-- Table View -->
        <TableView fx:id="itemTable" layoutX="34.0" layoutY="158.0" prefHeight="498.0" prefWidth="775.0" 
                   style="-fx-background-color: #1a1c29; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #3d405b; -fx-border-width: 1;">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="55.0" text="ID">
                    <cellValueFactory>
                        <PropertyValueFactory property="id" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="nameColumn" minWidth="8.0" prefWidth="200.0" text="Item Name">
                    <cellValueFactory>
                        <PropertyValueFactory property="name" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="priceColumn" prefWidth="120.0" text="Price">
                    <cellValueFactory>
                        <PropertyValueFactory property="price" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="quantityColumn" prefWidth="120.0" text="Quantity">
                    <cellValueFactory>
                        <PropertyValueFactory property="quantity" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <!-- Pagination -->
        <Pagination fx:id="pagination" layoutX="14.0" layoutY="665.0" maxPageIndicatorCount="5" prefHeight="30.0" prefWidth="700.0" />
        <!-- Rows Per Page ComboBox -->
        <ComboBox fx:id="rowCountComboBox" layoutX="734.0" layoutY="665.0" prefHeight="30.0" prefWidth="75.0" />
        <!-- Status Label -->
        <Label fx:id="statusLabel" layoutX="48.0" layoutY="670.0" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4caf50;" text="✅ Ready" />
    </children>
</AnchorPane>
