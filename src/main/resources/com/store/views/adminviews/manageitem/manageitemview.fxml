<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="727.0" prefWidth="848.0" style="-fx-background-color: linear-gradient(to bottom right, #1a1c29, #2b2e4a);" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.GUI.controllers.AdminControllers.ManageItem.ManageItemController">
    <children>
        <!-- Title -->
        <Label layoutX="-1.0" layoutY="14.0" prefHeight="57.0" prefWidth="848.0" style="-fx-alignment: center; -fx-font-weight: bold;" text="📦 Manage Items" textAlignment="CENTER" textFill="#e0e4f0">
            <font>
                <Font size="40.0" />
            </font>
        </Label>
        <!-- Go Back Button -->
        <Button layoutX="38.0" layoutY="30.0" onAction="#goBack" prefHeight="30.0" prefWidth="93.0" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-text-fill: #c5c9d6; -fx-font-weight: bold; -fx-cursor: hand;" text="← Back" />
        <!-- Search and Action Bar -->
        <HBox alignment="CENTER_LEFT" layoutX="34.0" layoutY="93.0" prefHeight="50.0" prefWidth="775.0" spacing="10" style="-fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 8; -fx-padding: 8 12;">
            <!-- Search Field -->
            <TextField fx:id="searchItemNameField" prefHeight="34.0" prefWidth="220.0" promptText="🔍 Search by item name..." style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-inner-color: white; -fx-prompt-text-fill: #80869a; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-padding: 0 12;">
                <font>
                    <Font size="14.0" />
                </font>
            </TextField>
            <!-- Push remaining items to the right -->
            <Region prefHeight="34.0" prefWidth="47.0" HBox.hgrow="ALWAYS" />
            <!-- Refresh Button -->
            <Button onAction="#refreshItems" prefHeight="34.0" style="-fx-background-color: rgba(52, 152, 219, 0.2); -fx-text-fill: #3498db; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #3498db; -fx-border-width: 1.5; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 0 15;" text="🔄 Refresh" />
            <!-- Add Button -->
            <Button onAction="#goToAddItem" prefHeight="34.0" style="-fx-background-color: linear-gradient(to right, #27ae60, #2ecc71); -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(39, 174, 96, 0.3), 10, 0, 0, 5); -fx-padding: 0 15;" text="➕ Add" />
            <!-- Update Button -->
            <Button onAction="#goToUpdateItem" prefHeight="34.0" style="-fx-background-color: linear-gradient(to right, #f39c12, #e67e22); -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(243, 156, 18, 0.3), 10, 0, 0, 5); -fx-padding: 0 15;" text="✏️ Update" />
            <!-- Delete Button -->
            <Button onAction="#deleteItem" prefHeight="34.0" style="-fx-background-color: rgba(244, 67, 54, 0.15); -fx-text-fill: #ef4444; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: rgba(244, 67, 54, 0.3); -fx-border-width: 1.5; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 0 15;" text="🗑️ Delete" />
        </HBox>
        <!-- Table View -->
        <TableView fx:id="itemTable" layoutX="34.0" layoutY="158.0" prefHeight="498.0" prefWidth="775.0" style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.1); -fx-border-width: 1;">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="55.0" style="-fx-text-fill: #e0e4f0; -fx-font-weight: bold;" text="ID" />
                <TableColumn fx:id="nameColumn" minWidth="8.0" prefWidth="200.0" style="-fx-text-fill: #e0e4f0; -fx-font-weight: bold;" text="Item Name" />
                <TableColumn fx:id="priceColumn" prefWidth="120.0" style="-fx-text-fill: #4caf50; -fx-font-weight: bold;" text="Price" />
                <TableColumn fx:id="quantityColumn" prefWidth="120.0" style="-fx-text-fill: #e0e4f0; -fx-font-weight: bold;" text="Quantity" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <!-- Pagination -->
        <Pagination fx:id="pagination" layoutX="14.0" layoutY="665.0" maxPageIndicatorCount="5" prefHeight="30.0" prefWidth="700.0" style="-fx-background-color: transparent;" />
        <!-- Rows Per Page ComboBox -->
        <ComboBox fx:id="rowCountComboBox" layoutX="734.0" layoutY="665.0" prefHeight="30.0" prefWidth="75.0" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-text-fill: white;" />
         <!-- Status Label (moved inside HBox for better alignment) -->
         <Label fx:id="statusLabel" layoutX="48.0" layoutY="670.0" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="✅ Ready" textFill="#4caf50" />
    </children>
</AnchorPane>
