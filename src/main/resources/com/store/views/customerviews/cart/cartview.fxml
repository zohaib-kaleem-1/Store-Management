<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<AnchorPane  stylesheets="@/com/store/styles/view-style.css" prefHeight="727.0" prefWidth="848.0" style="-fx-background-color: linear-gradient(to bottom right, #1a1c29, #2b2e4a);" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.GUI.controllers.CustomerControllers.Cart.CartController">
    <children>
        <!-- Title -->
        <Label layoutX="-1.0" layoutY="14.0" prefHeight="57.0" prefWidth="848.0" style="-fx-alignment: center; -fx-font-weight: bold; -fx-text-fill: #e0e4f0;" text="🛒 My Cart" textAlignment="CENTER">
            <font>
                <Font size="40.0" />
            </font>
        </Label>
        <!-- Go Back Button -->
        <Button layoutX="38.0" layoutY="30.0" onAction="#goBack" prefHeight="30.0" prefWidth="93.0" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-text-fill: #c5c9d6; -fx-font-weight: bold; -fx-cursor: hand;" text="← Back" />
        <!-- Cart Count Badge -->
        <Label layoutX="655.0" layoutY="33.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f39c12;" text="Total Item:" />
        <Label fx:id="cartCountLabel" layoutX="757.0" layoutY="33.0" prefHeight="25.0" prefWidth="46.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f39c12;" text="0" />
        <!-- Search and Action Bar -->
        <ButtonBar layoutX="33.0" layoutY="93.0" prefHeight="40.0" prefWidth="775.0" style="-fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 8; -fx-padding: 5 10;">
            <buttons>
                <TextField fx:id="searchItemNameField" prefHeight="30.0" promptText="🔍 Search by item name..." style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-fill: white; -fx-prompt-text-fill: #80869a; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-padding: 0 12;" />
                <Button minWidth="65.0" onAction="#updateItem" prefHeight="30.0" style="-fx-background-color: linear-gradient(to right, #f39c12, #e67e22); -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(243, 156, 18, 0.3), 10, 0, 0, 5);" text="✏️ Update" />
                <Button minWidth="65.0" onAction="#buyItems" prefHeight="30.0" style="-fx-background-color: linear-gradient(to right, #27ae60, #2ecc71); -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(39, 174, 96, 0.3), 10, 0, 0, 5);" text="💳 Buy Now" />
                <Button minWidth="65.0" onAction="#clearCart" prefHeight="30.0" style="-fx-background-color: rgba(244, 67, 54, 0.15); -fx-text-fill: #ef4444; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: rgba(244, 67, 54, 0.3); -fx-border-width: 1.5; -fx-cursor: hand; -fx-font-weight: bold;" text="🗑️ Clear" />
            </buttons>
        </ButtonBar>
        <!-- Table View -->
        <TableView fx:id="itemTable" layoutX="34.0" layoutY="146.0" prefHeight="509.0" prefWidth="775.0" style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.1); -fx-border-width: 1;">
            <columns>
                <TableColumn fx:id="nameColumn" minWidth="8.0" prefWidth="210.0" style="-fx-text-fill: #e0e4f0; -fx-font-weight: bold;" text="Item Name">
                    <cellValueFactory>
                        <PropertyValueFactory property="name" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="priceColumn" minWidth="0.0" prefWidth="105.0" style="-fx-text-fill: #e0e4f0; -fx-font-weight: bold;" text="Price">
                    <cellValueFactory>
                        <PropertyValueFactory property="price" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="quantityColumn" prefWidth="90.0" style="-fx-text-fill: #e0e4f0; -fx-font-weight: bold;" text="Quantity">
                    <cellValueFactory>
                        <PropertyValueFactory property="quantity" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="quantityInStoreColumn" prefWidth="155.0" style="-fx-text-fill: #e0e4f0; -fx-font-weight: bold;" text="Available">
                    <cellValueFactory>
                        <PropertyValueFactory property="quantityInStore" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="totalPriceColumn" prefWidth="215.0" style="-fx-text-fill: #4caf50; -fx-font-weight: bold;" text="Total Price">
                    <cellValueFactory>
                        <PropertyValueFactory property="totalPrice" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <!-- Total Price Label -->
        <Label layoutX="38.0" layoutY="669.0" prefHeight="40.0" prefWidth="250.0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #4caf50;" text="Total: $" />
        <Label fx:id="totalPriceLabel" layoutX="120.0" layoutY="673.0" prefHeight="32.0" prefWidth="139.0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #4caf50;" text="0.00" />
        <!-- Pagination -->
        <Pagination fx:id="pagination" layoutX="14.0" layoutY="665.0" maxPageIndicatorCount="5" prefHeight="30.0" prefWidth="700.0" style="-fx-background-color: transparent;" />
        <!-- Rows Per Page ComboBox -->
        <ComboBox fx:id="rowCountComboBox" layoutX="734.0" layoutY="665.0" prefHeight="30.0" prefWidth="75.0" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-text-fill: white;" />
        <!-- Status Label -->
        <Label layoutX="34.0" layoutY="705.0" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #a0a5b5;" text="" />
    </children>
</AnchorPane>
