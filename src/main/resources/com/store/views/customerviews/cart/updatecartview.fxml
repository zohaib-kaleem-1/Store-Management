<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: linear-gradient(to bottom right, #1a1c29, #2b2e4a);" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.GUI.controllers.CustomerControllers.Cart.UpdateCartController">
   <children>
      <!-- Title -->
      <Label alignment="CENTER" layoutY="32.0" prefHeight="18.0" prefWidth="600.0" style="-fx-font-weight: bold;" text="✏️ Update Cart Item" textFill="#e0e4f0">
         <font>
            <Font name="System Bold" size="25.0" />
         </font>
      </Label>
      <!-- Go Back Button -->
      <Button layoutX="20.0" layoutY="37.0" onAction="#goBack" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-text-fill: #c5c9d6; -fx-font-weight: bold; -fx-cursor: hand;" text="← Back" />
      <!-- Labels -->
      <Label layoutX="40.0" layoutY="94.0" style="-fx-font-weight: bold;" text="Item Name" textFill="#c5c9d6">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label layoutX="40.0" layoutY="149.0" style="-fx-font-weight: bold;" text="Price" textFill="#c5c9d6">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label layoutX="43.0" layoutY="203.0" prefHeight="29.0" prefWidth="112.0" style="-fx-font-weight: bold;" text="Quantity" textFill="#c5c9d6">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label layoutX="40.0" layoutY="256.0" prefHeight="29.0" prefWidth="173.0" style="-fx-font-weight: bold;" text="Available in Store" textFill="#c5c9d6">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label layoutX="43.0" layoutY="309.0" prefHeight="29.0" prefWidth="112.0" style="-fx-font-weight: bold;" text="Total Price" textFill="#c5c9d6">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <!-- Text Fields -->
      <TextField fx:id="itemNameField" editable="false" layoutX="200.0" layoutY="87.0" prefWidth="360.0" promptText="Item Name" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-inner-color: white; -fx-prompt-text-fill: #80869a; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-padding: 0 15;">
         <font>
            <Font size="16.0" />
         </font>
      </TextField>
      <TextField fx:id="priceField" editable="false" layoutX="200.0" layoutY="142.0" prefWidth="360.0" promptText="Price" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-inner-color: white; -fx-prompt-text-fill: #80869a; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-padding: 0 15;">
         <font>
            <Font size="16.0" />
         </font>
      </TextField>
      <TextField fx:id="quantityField" layoutX="200.0" layoutY="196.0" prefWidth="360.0" promptText="Enter new quantity" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-inner-color: white; -fx-prompt-text-fill: #80869a; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-padding: 0 15;">
         <font>
            <Font size="16.0" />
         </font>
      </TextField>
      <TextField fx:id="quantityInStoreField" editable="false" layoutX="200.0" layoutY="249.0" prefWidth="360.0" promptText="Available in store" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-inner-color: white; -fx-prompt-text-fill: #80869a; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-padding: 0 15;">
         <font>
            <Font size="16.0" />
         </font>
      </TextField>
      <TextField fx:id="totalPriceField" editable="false" layoutX="200.0" layoutY="302.0" prefWidth="360.0" promptText="Total price" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-inner-color: #4caf50; -fx-prompt-text-fill: #80869a; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(76, 175, 80, 0.3); -fx-border-width: 1.5; -fx-padding: 0 15; -fx-font-weight: bold;">
         <font>
            <Font size="16.0" />
         </font>
      </TextField>
      <!-- Status Label -->
      <Label layoutX="200.0" layoutY="365.0" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="" textFill="#ef4444" />
      <!-- Action Buttons -->
      <Button layoutX="43.0" layoutY="395.0" onAction="#delete" style="-fx-background-color: rgba(244, 67, 54, 0.15); -fx-text-fill: #ef4444; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(244, 67, 54, 0.3); -fx-border-width: 1.5; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 8 20;" text="🗑️ Delete">
         <font>
            <Font size="16.0" />
         </font>
      </Button>
      <Button layoutX="468.0" layoutY="397.0" onAction="#save" style="-fx-background-color: linear-gradient(to right, #27ae60, #2ecc71); -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(39, 174, 96, 0.3), 10, 0, 0, 5); -fx-padding: 8 25;" text=" Save" textFill="WHITE">
         <font>
            <Font size="16.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
