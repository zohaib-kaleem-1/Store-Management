<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="727.0" prefWidth="848.0" style="-fx-background-color: linear-gradient(to bottom right, #1a1c29, #2b2e4a);" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.GUI.controllers.CustomerControllers.BuyItem.BuyItemController">
    <children>
        <!-- ==================== TOP HEADER ==================== -->
        <VBox spacing="5" style="-fx-padding: 15 25 10 25; -fx-background-color: rgba(0,0,0,0.2);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button onAction="#goBack" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-cursor: hand; -fx-text-fill: #c5c9d6; -fx-font-weight: bold; -fx-padding: 8 15;" text="← Back" />
                <Label style="-fx-font-size: 28px;" text="🛍️" />
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Buy Items" textFill="#e0e4f0" />
                <Region HBox.hgrow="ALWAYS" />
                <Label prefHeight="22.0" prefWidth="48.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Cart:  " textFill="#f39c12" />
                <Label fx:id="cartCountLabel" prefHeight="22.0" prefWidth="14.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="0" textFill="#f39c12" />
                <Label style="-fx-font-size: 16px;" text="|" textFill="#6c728f" />
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="💰 $" textFill="#27ae60" />
                <Label fx:id="balanceLabel" style="-fx-font-size: 15px; -fx-font-weight: bold;" text="0.00" textFill="#27ae60" />
            </HBox>
        </VBox>
        <!-- ==================== SEARCH BAR ==================== -->
        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 15 25 15 25; -fx-background-color: rgba(0,0,0,0.15);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
            <TextField fx:id="searchItemNameField" prefHeight="35.0" promptText="🔍 Search by item name..." style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-inner-color: white; -fx-prompt-text-fill: #80869a; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-padding: 0 15;">
                <font>
                    <Font size="14.0" />
                </font>
            </TextField>
            <Button onAction="#searchItems" style="-fx-background-color: linear-gradient(to right, #2563eb, #3b82f6); -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 8 20; -fx-effect: dropshadow(three-pass-box, rgba(37, 99, 235, 0.3), 10, 0, 0, 5);" text="Search" />
            <Button onAction="#clearSearch" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-fill: #c5c9d6; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 8 15;" text="Clear" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#addToCart" style="-fx-background-color: linear-gradient(to right, #27ae60, #2ecc71); -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 8 25; -fx-effect: dropshadow(three-pass-box, rgba(39, 174, 96, 0.3), 10, 0, 0, 5);" text="➕ Add to Cart" />
        </HBox>
        <!-- ==================== TABLE VIEW ==================== -->
        <TableView fx:id="itemTable" layoutX="34.0" layoutY="135.0" prefHeight="510.0" prefWidth="775.0" style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.1); -fx-border-width: 1;">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="55.0" style="-fx-text-fill: #e0e4f0; -fx-font-weight: bold;" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="200.0" style="-fx-text-fill: #e0e4f0; -fx-font-weight: bold;" text="Item Name" />
                <TableColumn fx:id="priceColumn" prefWidth="120.0" style="-fx-text-fill: #e0e4f0; -fx-font-weight: bold;" text="Price" />
                <TableColumn fx:id="quantityColumn" prefWidth="120.0" style="-fx-text-fill: #e0e4f0; -fx-font-weight: bold;" text="Available" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <!-- ==================== PAGINATION ==================== -->
        <HBox alignment="CENTER" spacing="20" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="34.0" AnchorPane.rightAnchor="34.0">
            <Pagination fx:id="pagination" maxPageIndicatorCount="5" style="-fx-background-color: transparent; -fx-page-information-visible: false;" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="10">
                <Label style="-fx-font-size: 13px;" text="Rows per page:" textFill="#a0a5b5" />
                <ComboBox fx:id="rowCountComboBox" prefHeight="26.0" prefWidth="75.0" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-text-fill: white;" />
            </HBox>
        </HBox>
        <!-- ==================== STATUS MESSAGE ==================== -->
        <Label layoutX="34.0" layoutY="695.0" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="" textFill="#ef4444" />
    </children>
</AnchorPane>
