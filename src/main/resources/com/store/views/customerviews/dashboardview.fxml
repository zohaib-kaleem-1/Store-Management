<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<BorderPane prefHeight="600.0" prefWidth="800.0" 
            style="-fx-background-color: linear-gradient(to bottom right, #1a1c29, #2b2e4a);" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.store.GUI.controllers.CustomerControllers.DashboardController">
   <!-- ==================== TOP HEADER ==================== -->
   <top>
      <VBox spacing="5" style="-fx-padding: 15 25 10 25; -fx-background-color: rgba(0,0,0,0.2);">
         <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="🛒" style="-fx-font-size: 32px;"/>
            <Label text="Customer Dashboard" textFill="#e0e4f0" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" text="Welcome, User!" textFill="#3498db" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
         </HBox>
         <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>
      </VBox>
   </top>
   <!-- ==================== CENTER CONTENT ==================== -->
   <center>
      <VBox alignment="CENTER" spacing="20.0" 
              style="-fx-background-color: rgba(255, 255, 255, 0.07); -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: rgba(255, 255, 255, 0.12); -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 20, 0, 0, 10);" 
              BorderPane.alignment="CENTER">
         <VBox.margin>
            <Insets left="40.0" right="40.0" top="30.0" bottom="30.0" />
         </VBox.margin>
         <padding>
            <Insets bottom="35.0" left="40.0" right="40.0" top="35.0" />
         </padding>
         <!-- Dashboard Title -->
         <VBox alignment="CENTER" spacing="5">
            <Label text="Customer Menu" textFill="WHITE" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
            <Label text="What would you like to do today?" textFill="#a0a5b5" style="-fx-font-size: 14px;"/>
         </VBox>
         <Separator style="-fx-background-color: rgba(255,255,255,0.1);" prefWidth="450"/>
         <!-- Menu Grid -->
         <VBox spacing="15" alignment="CENTER">
            <!-- Row 1 -->
            <HBox spacing="25" alignment="CENTER">
               <!-- Buy Items Button -->
               <Button mnemonicParsing="false" onAction="#goToBuyItem" 
                            prefHeight="55.0" prefWidth="190.0" text="🛍️  Buy Items"
                            style="-fx-background-color: linear-gradient(to right, #2563eb, #3b82f6); -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-effect: dropshadow(three-pass-box, rgba(37, 99, 235, 0.3), 15, 0, 0, 5);"/>
               <!-- View Cart Button -->
               <Button mnemonicParsing="false" onAction="#goToViewCart" 
                            prefHeight="55.0" prefWidth="190.0" text="🛒  View Cart"
                            style="-fx-background-color: linear-gradient(to right, #f39c12, #e67e22); -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-effect: dropshadow(three-pass-box, rgba(243, 156, 18, 0.3), 15, 0, 0, 5);"/>
            </HBox>
            <!-- Row 2 -->
            <HBox spacing="25" alignment="CENTER">
               <!-- View Order History Button -->
               <Button mnemonicParsing="false" onAction="#goToViewOrder" 
                            prefHeight="55.0" prefWidth="190.0" text="📋  View Order History"
                            style="-fx-background-color: linear-gradient(to right, #8e44ad, #9b59b6); -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-effect: dropshadow(three-pass-box, rgba(142, 68, 173, 0.3), 15, 0, 0, 5);"/>
               <!-- Manage Account Button -->
               <Button mnemonicParsing="false" onAction="#goToManageAccount" 
                            prefHeight="55.0" prefWidth="190.0" text="👤  Manage Account"
                            style="-fx-background-color: linear-gradient(to right, #27ae60, #2ecc71); -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-effect: dropshadow(three-pass-box, rgba(39, 174, 96, 0.3), 15, 0, 0, 5);"/>
            </HBox>
            <!-- Row 3 -->
            <HBox spacing="25" alignment="CENTER">
               <!-- Change Password Button -->
               <Button mnemonicParsing="false" onAction="#goToChangePassword" 
                            prefHeight="55.0" prefWidth="190.0" text="🔒  Change Password"
                            style="-fx-background-color: linear-gradient(to right, #e74c3c, #c0392b); -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-effect: dropshadow(three-pass-box, rgba(231, 76, 60, 0.3), 15, 0, 0, 5);"/>
               <!-- Log Out Button -->
               <Button mnemonicParsing="false" onAction="#logOut" 
                            prefHeight="55.0" prefWidth="190.0" text="🚪  Log Out"
                            style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-text-fill: #c5c9d6; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            </HBox>
         </VBox>
         <Separator style="-fx-background-color: rgba(255,255,255,0.1);" prefWidth="450"/>
         <!-- Quick Stats -->
         <HBox spacing="35" alignment="CENTER" style="-fx-padding: 5 0 0 0;">
            <VBox alignment="CENTER" spacing="2">
               <Label text="🛍️" style="-fx-font-size: 20px;"/>
               <Label text="Active Orders" textFill="#a0a5b5" style="-fx-font-size: 11px;"/>
               <Label fx:id="activeOrdersLabel" text="0" textFill="#3498db" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="35" style="-fx-background-color: rgba(255,255,255,0.1);"/>
            <VBox alignment="CENTER" spacing="2">
               <Label text="🛒" style="-fx-font-size: 20px;"/>
               <Label text="Cart Items" textFill="#a0a5b5" style="-fx-font-size: 11px;"/>
               <Label fx:id="cartItemsLabel" text="0" textFill="#f39c12" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="35" style="-fx-background-color: rgba(255,255,255,0.1);"/>
            <VBox alignment="CENTER" spacing="2">
               <Label text="💰" style="-fx-font-size: 20px;"/>
               <Label text="Total Spent" textFill="#a0a5b5" style="-fx-font-size: 11px;"/>
               <Label fx:id="totalSpentLabel" text="$0.00" textFill="#27ae60" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </VBox>
         </HBox>
         <!-- Status/Error Message -->
         <Label fx:id="statusLabel" text="" textFill="#ef4444" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
      </VBox>
   </center>
   <!-- ==================== BOTTOM FOOTER ==================== -->
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="20" style="-fx-padding: 10 25 10 25; -fx-background-color: rgba(0,0,0,0.2);">
         <Label text="👤 Customer Portal" textFill="#6c728f" style="-fx-font-size: 12px;"/>
         <Region HBox.hgrow="ALWAYS" />
         <Label text="Version 2.0" textFill="#6c728f" style="-fx-font-size: 12px;"/>
      </HBox>
   </bottom>
</BorderPane>
