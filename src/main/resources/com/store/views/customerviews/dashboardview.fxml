<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="650.0" prefWidth="850.0" style="-fx-background-color: linear-gradient(to bottom right, #1a1c29, #2b2e4a);" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.store.GUI.controllers.CustomerControllers.DashboardController">
   <!-- ==================== TOP HEADER ==================== -->
   <top>
      <VBox spacing="5" style="-fx-padding: 15 25 10 25; -fx-background-color: rgba(0,0,0,0.2);">
         <HBox alignment="CENTER_LEFT" spacing="15">
            <Label style="-fx-font-size: 32px;" text="🛒" />
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Customer Dashboard" textFill="#e0e4f0" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="welcomeLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Welcome, User!" textFill="#3498db" />
            <Label style="-fx-font-size: 16px;" text="|" textFill="#6c728f" />
            <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="💰 $" textFill="#27ae60" />
            <Label fx:id="balanceLabel1" style="-fx-font-size: 15px; -fx-font-weight: bold;" text="0.00" textFill="#27ae60" />
         </HBox>
         <Separator style="-fx-background-color: rgba(255,255,255,0.1);" />
      </VBox>
   </top>
   <!-- ==================== CENTER CONTENT ==================== -->
   <center>
      <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: rgba(255, 255, 255, 0.07); -fx-border-color: rgba(255, 255, 255, 0.12); -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 20, 0, 0, 10);" BorderPane.alignment="CENTER">
         <VBox.margin>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
         </VBox.margin>
         <padding>
            <Insets bottom="35.0" left="40.0" right="40.0" top="35.0" />
         </padding>
         <!-- Dashboard Title -->
         <VBox alignment="CENTER" spacing="5">
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Customer Menu" textFill="WHITE" />
            <Label style="-fx-font-size: 14px;" text="What would you like to do today?" textFill="#a0a5b5" />
         </VBox>
         <Separator prefWidth="500" style="-fx-background-color: rgba(255,255,255,0.1);" />
         <!-- Menu Grid - 2 Columns -->
         <VBox alignment="CENTER" spacing="20">
            <!-- Row 1 -->
            <HBox alignment="CENTER" spacing="30">
               <Button onAction="#goToBuyItem" prefHeight="65.0" prefWidth="220.0" style="-fx-background-color: linear-gradient(to right, #2563eb, #3b82f6); -fx-text-fill: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-effect: dropshadow(three-pass-box, rgba(37, 99, 235, 0.4), 15, 0, 0, 5);" text="🛍️  Buy Items" />
               <Button onAction="#goToViewCart" prefHeight="65.0" prefWidth="220.0" style="-fx-background-color: linear-gradient(to right, #f39c12, #e67e22); -fx-text-fill: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-effect: dropshadow(three-pass-box, rgba(243, 156, 18, 0.4), 15, 0, 0, 5);" text="🛒  View Cart" />
            </HBox>
            <!-- Row 2 -->
            <HBox alignment="CENTER" spacing="30">
               <Button onAction="#goToViewOrderHistory" prefHeight="65.0" prefWidth="220.0" style="-fx-background-color: linear-gradient(to right, #8e44ad, #9b59b6); -fx-text-fill: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-effect: dropshadow(three-pass-box, rgba(142, 68, 173, 0.4), 15, 0, 0, 5);" text="📋  Order History" />
               <Button onAction="#goToManageAccount" prefHeight="65.0" prefWidth="220.0" style="-fx-background-color: linear-gradient(to right, #27ae60, #2ecc71); -fx-text-fill: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-effect: dropshadow(three-pass-box, rgba(39, 174, 96, 0.4), 15, 0, 0, 5);" text="👤  Manage Account" />
            </HBox>
            <!-- Row 3 -->
            <HBox alignment="CENTER" spacing="30">
               <Button onAction="#goToChangePassword" prefHeight="65.0" prefWidth="220.0" style="-fx-background-color: linear-gradient(to right, #e74c3c, #c0392b); -fx-text-fill: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-effect: dropshadow(three-pass-box, rgba(231, 76, 60, 0.4), 15, 0, 0, 5);" text="🔑  Change Password" />
               <!-- Empty placeholder - using Button with no text and invisible -->
               <Button disable="true" prefHeight="65.0" prefWidth="220.0" style="-fx-opacity: 0; -fx-cursor: default;" />
            </HBox>
            <!-- Row 4 - Logout Button (Full Width) -->
            <Button maxWidth="470.0" onAction="#logOut" prefHeight="50.0" style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-fill: #c5c9d6; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 20;" text="🚪  Log Out" />
         </VBox>
         <Separator prefWidth="500" style="-fx-background-color: rgba(255,255,255,0.1);" />
         <!-- Quick Stats -->
         <HBox alignment="CENTER" spacing="60" style="-fx-padding: 5 0 0 0;">
            <VBox alignment="CENTER" spacing="3">
               <Label style="-fx-font-size: 11px;" text="Active Orders" textFill="#a0a5b5" />
               <Label fx:id="numberOfActiveOrdersLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="0" textFill="#3498db" />
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="45" style="-fx-background-color: rgba(255,255,255,0.1);" />
            <VBox alignment="CENTER" spacing="3">
               <Label style="-fx-font-size: 11px;" text="Cart Items" textFill="#a0a5b5" />
               <Label fx:id="numberOfCartItemsLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="0" textFill="#f39c12" />
            </VBox>
            <Separator orientation="VERTICAL" prefHeight="45" style="-fx-background-color: rgba(255,255,255,0.1);" />
            <VBox alignment="CENTER" spacing="3">
               <Label style="-fx-font-size: 11px;" text="Total Spent" textFill="#a0a5b5" />
               <Label fx:id="totalSpentLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="0" textFill="#f39c12" />
            </VBox>
         </HBox>
         <!-- Status Message -->
         <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="" textFill="#ef4444" />
      </VBox>
   </center>
   <!-- ==================== BOTTOM FOOTER ==================== -->
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="20" style="-fx-padding: 10 25 10 25; -fx-background-color: rgba(0,0,0,0.2);">
         <Label style="-fx-font-size: 12px;" text="👤 Customer Portal" textFill="#6c728f" />
         <Region HBox.hgrow="ALWAYS" />
         <Label style="-fx-font-size: 12px;" text="🟢 Online" textFill="#4caf50" />
         <Label style="-fx-font-size: 12px;" text="|" textFill="#6c728f" />
         <Label style="-fx-font-size: 12px;" text="Version 2.0" textFill="#6c728f" />
      </HBox>
   </bottom>
</BorderPane>
