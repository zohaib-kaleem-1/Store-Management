<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="750.0" prefWidth="1000.0" 
            style="-fx-background-color: linear-gradient(to bottom right, #1a1c29, #2b2e4a);" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.store.GUI.controllers.CustomerControllers.OrderController">
    <!-- ==================== TOP HEADER ==================== -->
    <top>
        <VBox spacing="5" style="-fx-padding: 15 25 10 25; -fx-background-color: rgba(0,0,0,0.2);">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button onAction="#goBack" 
                        text="← Go Back" prefHeight="35.0"
                        style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-fill: #c5c9d6; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-cursor: hand; -fx-padding: 0 20; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="📦" style="-fx-font-size: 28px;"/>
                <Label text="My Orders" textFill="#e0e4f0" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#refreshOrders" 
                        text="🔄 Refresh" prefHeight="35.0"
                        style="-fx-background-color: rgba(52, 152, 219, 0.2); -fx-text-fill: #3498db; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #3498db; -fx-border-width: 1.5; -fx-cursor: hand; -fx-padding: 0 20; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            </HBox>
            <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>
        </VBox>
    </top>
    <!-- ==================== CENTER CONTENT ==================== -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20 25 20 25;">
            <!-- Search and Filter Bar -->
            <HBox spacing="15" alignment="CENTER_LEFT" 
                  style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 12; -fx-padding: 12 18; -fx-border-radius: 12; -fx-border-color: rgba(255, 255, 255, 0.08); -fx-border-width: 1;">
                <Label text="🔍" textFill="#a0a5b5" style="-fx-font-size: 16px;"/>
                <TextField fx:id="searchField" promptText="Search by Order ID or Item..." prefHeight="36.0" prefWidth="220.0"
                           style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-inner-color: white; -fx-prompt-text-fill: #80869a; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-padding: 0 15; -fx-font-size: 13px;"/>
                <Separator orientation="VERTICAL" prefHeight="30" style="-fx-background-color: rgba(255,255,255,0.1);"/>
                <Label text="📊 Status:" textFill="#c5c9d6" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                <ComboBox fx:id="orderStatusComboBox" prefWidth="150.0" prefHeight="36.0"
                          promptText="All Orders"
                          style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-padding: 0 10; -fx-font-size: 13px;"/>
                <Separator orientation="VERTICAL" prefHeight="30" style="-fx-background-color: rgba(255,255,255,0.1);"/>
                <Label text="📅 Date:" textFill="#c5c9d6" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                <ComboBox fx:id="dateFilterComboBox" prefWidth="130.0" prefHeight="36.0"
                          promptText="All Time"
                          style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-padding: 0 10; -fx-font-size: 13px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Action Buttons -->
                <Button onAction="#viewOrderDetails" 
                        text="📄 View Details" prefHeight="36.0"
                        style="-fx-background-color: rgba(52, 152, 219, 0.2); -fx-text-fill: #3498db; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #3498db; -fx-border-width: 1.5; -fx-cursor: hand; -fx-padding: 0 20; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <Button onAction="#cancelOrder" 
                        text="❌ Cancel Order" prefHeight="36.0"
                        style="-fx-background-color: rgba(231, 76, 60, 0.15); -fx-text-fill: #e74c3c; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(231, 76, 60, 0.3); -fx-border-width: 1.5; -fx-cursor: hand; -fx-padding: 0 20; -fx-font-weight: bold; -fx-font-size: 13px;"/>
            </HBox>
            <!-- Order Table -->
            <TreeTableView fx:id="orderTable" prefHeight="520.0" 
                           style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: rgba(255, 255, 255, 0.08); -fx-border-width: 1;">
                <columns>
                    <TreeTableColumn fx:id="orderIdColumn" text="Order ID" prefWidth="80.0"/>
                    <TreeTableColumn fx:id="boughtAtColumn" text="Bought At" prefWidth="130.0"/>
                    <TreeTableColumn fx:id="addressColumn" text="Address" prefWidth="160.0"/>
                    <TreeTableColumn fx:id="statusColumn" text="Status" prefWidth="120.0"/>
                    <TreeTableColumn fx:id="totalPriceColumn" text="Total Price" prefWidth="110.0"/>
                    <TreeTableColumn fx:id="itemIdColumn" text="Item ID" prefWidth="80.0"/>
                    <TreeTableColumn fx:id="itemNameColumn" text="Item Name" prefWidth="130.0"/>
                    <TreeTableColumn fx:id="priceColumn" text="Price" prefWidth="100.0"/>
                    <TreeTableColumn fx:id="quantityColumn" text="Quantity" prefWidth="90.0"/>
                    <TreeTableColumn fx:id="subtotalColumn" text="Subtotal" prefWidth="110.0"/>
                </columns>
            </TreeTableView>
            <!-- Bottom Controls -->
            <HBox alignment="CENTER_LEFT" spacing="15"
                  style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 12; -fx-padding: 10 18; -fx-border-radius: 12; -fx-border-color: rgba(255, 255, 255, 0.08); -fx-border-width: 1;">
                <Label text="📊 Summary:" textFill="#c5c9d6" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                <VBox spacing="2">
                    <HBox spacing="8">
                        <Label text="Total Orders:" textFill="#a0a5b5" style="-fx-font-size: 12px;"/>
                        <Label fx:id="totalOrdersLabel" text="0" textFill="#3498db" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
                <Separator orientation="VERTICAL" prefHeight="25" style="-fx-background-color: rgba(255,255,255,0.1);"/>
                <VBox spacing="2">
                    <HBox spacing="8">
                        <Label text="Total Items:" textFill="#a0a5b5" style="-fx-font-size: 12px;"/>
                        <Label fx:id="totalItemsLabel" text="0" textFill="#27ae60" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
                <Separator orientation="VERTICAL" prefHeight="25" style="-fx-background-color: rgba(255,255,255,0.1);"/>
                <VBox spacing="2">
                    <HBox spacing="8">
                        <Label text="Total Spent:" textFill="#a0a5b5" style="-fx-font-size: 12px;"/>
                        <Label fx:id="totalRevenueLabel" text="$0.00" textFill="#f39c12" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Rows:" textFill="#a0a5b5" style="-fx-font-size: 12px;"/>
                <ComboBox fx:id="rowCountComboBox" prefWidth="70.0" prefHeight="30.0"
                          promptText="10"
                          style="-fx-background-color: rgba(255, 255, 255, 0.08); -fx-text-fill: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.15); -fx-border-width: 1.5; -fx-font-size: 13px;"/>
                <Pagination fx:id="pagination" prefHeight="30.0" prefWidth="200.0" 
                            maxPageIndicatorCount="5"
                            style="-fx-background-color: transparent;"/>
            </HBox>
        </VBox>
    </center>
    <!-- ==================== BOTTOM STATUS BAR ==================== -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 10 25 10 25; -fx-background-color: rgba(0,0,0,0.2);">
            <Label fx:id="statusLabel" text="✅ Ready" textFill="#27ae60" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="💡 Double-click an order to view details" textFill="#6c728f" style="-fx-font-size: 11px; -fx-font-style: italic;"/>
            <Label text="|" textFill="#6c728f"/>
            <Label text="📋 Orders loaded successfully" textFill="#6c728f" style="-fx-font-size: 11px;"/>
            <Label text="|" textFill="#6c728f"/>
            <Label text="🟢 Online" textFill="#4caf50" style="-fx-font-size: 11px;"/>
        </HBox>
    </bottom>
</BorderPane>
