<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.store.GUI.controllers.CustomerControllers.OrderController"
            prefHeight="700.0" prefWidth="1200.0">
    <!-- ==================== TOP HEADER ==================== -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label text="📦 Order Management" 
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="Welcome, " style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
                <Label fx:id="welcomeLabel" text="User" 
                       style="-fx-text-fill: #3498db; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Refresh" onAction="#refreshOrders" 
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15;"/>
                <Button text="🛒 Back to Shopping" onAction="#goToShopping" 
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15;"/>
            </HBox>
        </VBox>
    </top>
    <!-- ==================== CENTER CONTENT ==================== -->
    <center>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #ecf0f1;">
            <!-- ===== FILTER SECTION ===== -->
            <HBox spacing="10" alignment="CENTER_LEFT" 
                  style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-width: 1; -fx-border-radius: 5;">
                <Label text="Status:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="statusFilterCombo" prefWidth="120" 
                         onAction="#filterOrders" promptText="All Orders"/>
                <Separator orientation="VERTICAL" prefHeight="30"/>
                <Label text="Search:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="searchField" promptText="Search by order ID or customer..." 
                           onKeyReleased="#searchOrders" prefWidth="200"/>
                <Separator orientation="VERTICAL" prefHeight="30"/>
                <Button text="📂 Expand All" onAction="#expandAll" 
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 5 15;"/>
                <Button text="📁 Collapse All" onAction="#collapseAll" 
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 5 15;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Total Orders:" style="-fx-font-weight: bold;"/>
                <Label fx:id="totalOrdersLabel" text="0" 
                       style="-fx-text-fill: #3498db; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                <Label text="|" style="-fx-text-fill: #bdc3c7;"/>
                <Label text="Total Items:" style="-fx-font-weight: bold;"/>
                <Label fx:id="totalItemsLabel" text="0" 
                       style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            </HBox>
            <!-- ===== TREE TABLE VIEW ===== -->
            <TreeTableView fx:id="orderTreeTable" 
                          style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-width: 1; -fx-border-radius: 5;"
                          prefHeight="480">
                <columns>
                    <!-- ORDER COLUMNS (Parent Level - Visible for Orders) -->
                    <TreeTableColumn text="Order ID" prefWidth="80" fx:id="orderIdCol" 
                                     style="-fx-alignment: CENTER;"/>
                    <TreeTableColumn text="Customer Name" prefWidth="150" fx:id="customerNameCol"/>
                    <TreeTableColumn text="Customer ID" prefWidth="100" fx:id="customerIdCol" 
                                     style="-fx-alignment: CENTER;"/>
                    <TreeTableColumn text="Total Price" prefWidth="120" fx:id="totalPriceCol" 
                                     style="-fx-alignment: CENTER-RIGHT;"/>
                    <TreeTableColumn text="Address" prefWidth="180" fx:id="addressCol"/>
                    <TreeTableColumn text="Status" prefWidth="120" fx:id="statusCol" 
                                     style="-fx-alignment: CENTER;"/>
                    <TreeTableColumn text="Order Date" prefWidth="150" fx:id="orderDateCol" 
                                     style="-fx-alignment: CENTER;"/>
                    <!-- ITEM COLUMNS (Child Level - Visible for Items) -->
                    <TreeTableColumn text="Item ID" prefWidth="80" fx:id="itemIdCol" 
                                     style="-fx-alignment: CENTER;"/>
                    <TreeTableColumn text="Item Name" prefWidth="150" fx:id="itemNameCol"/>
                    <TreeTableColumn text="Price" prefWidth="100" fx:id="itemPriceCol" 
                                     style="-fx-alignment: CENTER-RIGHT;"/>
                    <TreeTableColumn text="Qty" prefWidth="80" fx:id="itemQuantityCol" 
                                     style="-fx-alignment: CENTER;"/>
                    <TreeTableColumn text="Subtotal" prefWidth="100" fx:id="itemSubtotalCol" 
                                     style="-fx-alignment: CENTER-RIGHT;"/>
                    <!-- ACTIONS COLUMN -->
                    <TreeTableColumn text="Actions" prefWidth="200" fx:id="actionsCol" 
                                     style="-fx-alignment: CENTER;"/>
                </columns>
                <!-- Add some style to the table -->
                <rowFactory>
                    <TreeTableRowFactory/>
                </rowFactory>
            </TreeTableView>
            <!-- ===== LEGEND SECTION ===== -->
            <HBox spacing="20" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-width: 1; -fx-border-radius: 5;">
                <Label text="📌 Status Legend:" style="-fx-font-weight: bold;"/>
                <HBox spacing="15">
                    <Label text="● Pending" style="-fx-text-fill: #f39c12; -fx-font-weight: bold;"/>
                    <Label text="● Confirmed" style="-fx-text-fill: #3498db; -fx-font-weight: bold;"/>
                    <Label text="● Shipped" style="-fx-text-fill: #9b59b6; -fx-font-weight: bold;"/>
                    <Label text="● Delivered" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                    <Label text="● Cancelled" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="💡 Click the arrow ▶ to expand order and view items" 
                       style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
                <Label text="🔹 Double-click to expand/collapse" 
                       style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </HBox>
        </VBox>
    </center>
    <!-- ==================== BOTTOM STATUS BAR ==================== -->
    <bottom>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 8 15;" alignment="CENTER_LEFT">
            <Label fx:id="statusLabel" text="Ready" style="-fx-text-fill: #ecf0f1; -fx-font-size: 12px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="📋 Orders loaded successfully" style="-fx-text-fill: #bdc3c7; -fx-font-size: 11px;"/>
        </HBox>
    </bottom>
</BorderPane>
